# --- Un-ignore rules (must stay first) -----------------------------------------
# This repository is a distributable agent framework: the Claude Code (.claude/)
# and Cursor (.cursor/) artifacts are part of what people copy, so they MUST be
# tracked. This overrides the user's global gitignore (~/.gitignore: *claude*,
# .cursor/) for this repo only. Contributors whose global config does not ignore
# those paths are unaffected by these lines.
#
# Source of truth is .github/{agents,skills,commands}. The derived .claude/,
# .cursor/rules/, and the marketplace plugin components (root agents/ skills/
# commands/) are generated by `scripts/install.sh --target repo` — regenerate
# rather than hand-editing.
!.claude/
!.claude/**
!.claude-plugin/
!.claude-plugin/**
!.cursor/
!.cursor/**

# --- Ordinary ignores ----------------------------------------------------------
# Tool caches that other projects' tooling can drop here. There is no Python,
# Node, or compiled code in this repository; these are strictly cruft.
.ruff_cache/
.mypy_cache/
.pytest_cache/
__pycache__/
node_modules/

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Local scratch — keep experiments out of a repo whose whole product is its text
*.bak
*.orig
*.rej
*.local
/tmp/
/scratch/

# Advisory pipeline runs are throwaway by default (see process/advisory-pipeline-usage.md).
# To keep a specific run, commit its folder deliberately: `git add -f agents-run/<folder>`.
agents-run/
